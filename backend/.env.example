# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. Never commit real credentials.

# development | test | production
NODE_ENV=development

# Port the API listens on. Render sets this automatically in production.
PORT=3000

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string from Supabase.
# Dashboard: Project > Connect > "Session pooler" (IPv4 compatible).
# Looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional in development (the API runs without it). Required in production.
DATABASE_URL=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# The API uses it to verify access tokens with the project's PUBLIC signing keys.
# No Supabase secret / service_role key is needed for this.
# Optional in development (protected routes return 503 without it). Required in production.
SUPABASE_URL=

# Supabase SECRET key (Project Settings > API Keys > secret key, sb_secret_...).
# SERVER ONLY: used for private Storage (signed upload/download URLs, checking uploaded files).
# Never put this in frontend/.env. Optional in development (file uploads answer 503 without it).
# Required in production.
SUPABASE_SECRET_KEY=

# WebRTC STUN/TURN servers for calls, as a JSON array. Optional: defaults to a public STUN server
# ([{"urls":"stun:stun.l.google.com:19302"}]). STUN carries no media. A TURN relay (for networks
# that block direct connections) is not configured yet; when added, prefer a provider's
# short-lived credentials. Example:
# ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]
ICE_SERVERS=
