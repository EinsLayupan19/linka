# Copy this file to frontend/.env and fill in real values.
# frontend/.env is git-ignored.
#
# Every VITE_ variable is bundled into the public JavaScript and visible to anyone.
# Only put PUBLIC values here. Never put a Supabase secret / service_role key here.

# Base URL of the Linka API (no trailing slash).
VITE_API_URL=http://localhost:3000

# Supabase dashboard: Project Settings > API Keys (or the "Connect" button).
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=
